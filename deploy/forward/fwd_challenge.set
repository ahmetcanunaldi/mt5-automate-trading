; v2.2 forward test - challenge mode, $100k demo (EA XauIdxPortfolio v2.21)
; Attach to an XAUUSD chart (any timeframe). Set InpNasSymbol / InpDjSymbol to the demo server's names;
; if the demo server has no Nasdaq-100 / Dow Jones CFD, set InpTradeNas / InpTradeDj = false.
InpInitialBalance=100000
InpRiskPct=0.5
