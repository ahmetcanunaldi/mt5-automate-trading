InpTotalStopPct=8.0
InpMaxPositions=6
InpMaxOpenRiskPct=3.0
InpMaxTradesDay=8
InpCommXau=7.0
InpCommIdx=0.0
InpFirstEntryMin=65
InpLastEntryMin=1390
InpNewsBefore=10
InpNewsAfter=10
InpNewsFlatten=10
